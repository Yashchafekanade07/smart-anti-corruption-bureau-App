<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#090E1B"
        tools:context=".ComplaintActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMART ANTI-CORRUPTION BUREAU"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Lodge a Complaint"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Provide incident details below."
                android:textColor="#B9C6D8"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etComplaintTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Complaint title"
                android:inputType="textCapSentences"
                android:padding="14dp"
                android:backgroundTint="#FFD54F"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAB6CC" />

            <Spinner
                android:id="@+id/spCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FFD54F" />

            <EditText
                android:id="@+id/etDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Department"
                android:inputType="textCapWords"
                android:padding="14dp"
                android:backgroundTint="#FFD54F"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAB6CC" />

            <EditText
                android:id="@+id/etDistrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="District"
                android:inputType="textCapWords"
                android:padding="14dp"
                android:backgroundTint="#FFD54F"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAB6CC" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:hint="Describe the incident"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="14dp"
                android:backgroundTint="#FFD54F"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAB6CC" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="OPTIONAL EVIDENCE"
                android:textColor="#FFD54F"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCaptureEvidence"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="📷 Capture Photo Evidence"
                android:textAllCaps="false"
                android:backgroundTint="#263D9B"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvEvidenceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No photo attached"
                android:textColor="#B9C6D8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGetLocation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="📍 Attach Current Location"
                android:textAllCaps="false"
                android:backgroundTint="#146C43"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvLocationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Location not attached"
                android:textColor="#B9C6D8"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbAnonymous"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Request anonymous reporting"
                android:textColor="#FFFFFF"
                android:buttonTint="#FF7900" />

            <Button
                android:id="@+id/btnSubmitComplaint"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#FF7900"
                android:text="Submit Complaint"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>