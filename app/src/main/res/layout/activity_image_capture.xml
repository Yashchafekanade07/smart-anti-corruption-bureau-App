<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#080E1B">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ACB Image Capture"
        android:textColor="#FFD54F"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="35dp" />

    <ImageView
        android:id="@+id/imagePreview"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:scaleType="centerCrop"
        android:background="#263248"
        android:contentDescription="Captured image preview" />

    <Button
        android:id="@+id/btnCapture"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="25dp"
        android:text="Capture Image"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnSaveImage"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="Save Image"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/tvImageStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Capture an image to begin"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center" />

</LinearLayout>