<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="#090E1B">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Smart ACB — Case Management" android:textColor="#FFD54F"
        android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Academic prototype • Local records only • Tap a case to update status or view its audit trail."
        android:textColor="#FFB4A9" android:textSize="13sp" />
    <TextView android:id="@+id/tvAdminCount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="16dp" android:paddingBottom="12dp"
        android:text="Total local complaints: 0" android:textColor="#FFFFFF" android:textStyle="bold" />
    <Button android:id="@+id/btnAdminRefresh" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Refresh complaints"
        android:textAllCaps="false" android:backgroundTint="#263D9B" />
    <ListView android:id="@+id/listAdminComplaints" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"
        android:divider="#30405A" android:dividerHeight="8dp" />
    <TextView android:id="@+id/tvAdminEmpty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="20dp" android:gravity="center"
        android:text="No complaints available." android:textColor="#FFFFFF" android:visibility="gone" />
</LinearLayout>
