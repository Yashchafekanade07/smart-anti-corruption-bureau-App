<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#090E1B"
        android:padding="20dp"
        tools:context=".MyComplaintsActivity">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Complaints"
            android:textColor="#FFD54F"
            android:textSize="27sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complaints saved on this device (local prototype)"
            android:textColor="#B9C6D8"
            android:textSize="14sp"
            android:paddingBottom="18dp"/>

        <ListView
            android:id="@+id/listComplaints"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#30405A"
            android:dividerHeight="8dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="No complaints saved yet."
            android:textColor="#FFFFFF"
            android:visibility="gone"/>

    </LinearLayout>
